<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The valley is planned in C# at startup and in every check; unoptimised code made that slower. -->
    <Optimize>true</Optimize>
    <!-- Methods with loops are compiled optimised at once; the startup planning runs most of its loops only once. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>
  <!-- Release exports ship without the headless checks and capture views. -->
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="Scripts/Diagnostics/**" />
  </ItemGroup>
</Project>
